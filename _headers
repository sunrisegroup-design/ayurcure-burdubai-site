/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

/photos/*
  Cache-Control: public, max-age=2592000
/posters/*
  Cache-Control: public, max-age=2592000
/branding/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
